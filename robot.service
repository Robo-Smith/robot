[Unit]
Description=YardBot controller and motor interface

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rs/.Xauthority
WorkingDirectory=/home/rs/robot
ExecStart=/usr/bin/python3 -u /home/rs/robot/Pi.py
StandardOutput=append:/home/rs/robot.log
StandardError=inherit
Restart=always
RestartSec=10s
KillMode=control-group
TimeoutStopSec=5s

[Install]
WantedBy=graphical.target
